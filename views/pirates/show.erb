<h1>Display your Pirate here</h1>
  <h2>Pirate Name:</h2>
  <p><%= @pirate.name %></p>

  <h2>Pirate Weight:</h2>
  <p><%= @pirate.weight %></p>

  <h2>Pirate Height:</h2>
  <p><%= @pirate.height %></p>

<h2>Display your first ship here</h2>
<% ship1 = @ships[0] %>
<% if ship1 %>
  <p><%= ship1.name %></p>
  <p><%= ship1.type %></p>
  <p><%= ship1.booty %></p>
<% end %>

<h2>Display your second ship here</h2>
<% ship2 = @ships[1] %>
<% if ship2 %>
  <p><%= ship2.name %></p>
  <p><%= ship2.type %></p>
  <p><%= ship2.booty %></p>
<% end %>
